{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dynooh SiteManager",
  "version": "0.1.7",
  "identifier": "ch.visual-fantastix.sitemanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dynooh SiteManager",
        "width": 1500,
        "height": 920,
        "minWidth": 1000,
        "minHeight": 600,
        "visible": false,
        "backgroundColor": "#1e1f22"
      },
      {
        "label": "splash",
        "title": "Dynooh SiteManager",
        "url": "splash.html",
        "width": 520,
        "height": 400,
        "center": true,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
